# .NET
bin/
obj/
*.user
.vs/
TestResults/

# Angular / Node (kickoff-client has its own .gitignore too, this covers root-level tooling)
node_modules/
dist/
.angular/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local secrets / env overrides — connection strings belong in dotnet user-secrets, never here
appsettings.*.local.json
*.env
.env.local

# Personal-use ROM files (e.g. the Tecmo Super Bowl cartridge dump for the Retro Football
# mini-game) — this repo is public on GitHub, so a committed ROM would be public
# distribution of copyrighted material, not just personal use. Never commit these.
/ROMs/
*.nes

