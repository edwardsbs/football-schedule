{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SportsData": {
    "Provider": "Espn",
    "SeasonType": "REG",
    "LiveSyncEnabled": true,
    "LivePollSeconds": 10,
    "LiveLeagues": [ "Nfl", "Ncaa" ],
    "ScheduleSyncEnabled": true,
    "ScheduleSyncHours": 24
  }
}
